# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Distribution archives (git archive, Composer dist installs) contain only what users need.
# Everything at the top level is excluded by default; add new user-facing files below.
/*                  export-ignore
/bin                -export-ignore
/src                -export-ignore
/composer.json      -export-ignore
/LICENSE            -export-ignore
/README.md          -export-ignore
/CHANGELOG.md       -export-ignore
